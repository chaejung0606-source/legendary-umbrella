# ───────────────────────────────────────────────────────────────
# Database (PostgreSQL — Supabase / Neon 등)
#   DATABASE_URL : 풀링(pgbouncer) 연결 — 런타임 쿼리용
#   DIRECT_URL   : 직접 연결 — 마이그레이션 / prisma db push 용
# Supabase → Connect → ORMs 탭의 두 문자열을 그대로 사용(비밀번호 교체).
# 배포(Vercel)에서는 프로젝트 환경변수로 설정한다.
# ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-xxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-xxx.pooler.supabase.com:5432/postgres"

# ───────────────────────────────────────────────────────────────
# Auth — JWT 세션 서명 시크릿. 운영에서는 반드시 교체.
#   openssl rand -base64 32
# ───────────────────────────────────────────────────────────────
AUTH_SECRET="dev-only-insecure-secret-change-me-in-production-please"

# ───────────────────────────────────────────────────────────────
# (선택) 구글시트 연동 CSV 보호 — /api/sheets/*
#   구글이 로그인 없이 가져가야 하므로 쿠키 인증을 걸 수 없다. 대신 이 값을 설정하면
#   `?key=<값>` 이 맞는 요청에만 응답한다(설정 > 구글시트 연동의 수식에 자동 반영).
#   대여 시트에는 이름·소속·사번/학번·전화번호가 들어가므로 운영에서는 설정을 권장한다.
#   미설정 시 지금까지처럼 주소만 알면 누구나 받을 수 있는 공개 상태가 된다.
#   openssl rand -hex 24
# ───────────────────────────────────────────────────────────────
# SHEETS_ACCESS_KEY=""

# ───────────────────────────────────────────────────────────────
# (선택) 빌드 시 DB 준비 동작 — scripts/db-prepare.ts
#   DB_PREPARE_STRICT=1     : DB 연결 실패를 빌드 실패로 처리(기본은 경고 후 계속)
#   DB_PREPARE_TIMEOUT_MS   : 연결 확인 제한 시간(ms, 기본 15000)
# ───────────────────────────────────────────────────────────────
# DB_PREPARE_STRICT="1"

# (선택) 시드 관리자 계정 기본값
SEED_ADMIN_EMAIL="admin@sadan.local"
SEED_ADMIN_PASSWORD="admin1234"
SEED_ADMIN_NAME="시스템 관리자"
