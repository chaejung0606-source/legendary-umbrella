# ───────────────────────────────────────────────────────────────
# Database
# Local development uses SQLite (no external service required).
# For production, switch prisma/schema.prisma `provider` to "postgresql"
# and set DATABASE_URL to your Postgres connection string, e.g.:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/sadan_asset?schema=public"
# ───────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ───────────────────────────────────────────────────────────────
# Auth — JWT session signing secret. MUST be changed in production.
# Generate one with: openssl rand -base64 32
# ───────────────────────────────────────────────────────────────
AUTH_SECRET="dev-only-insecure-secret-change-me-in-production-please"

# Seed admin account (created by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@sadan.local"
SEED_ADMIN_PASSWORD="admin1234"
SEED_ADMIN_NAME="시스템 관리자"
