// 사업단 자산관리 플랫폼 — Prisma schema
// 앱 도메인 타입(src/types)과 1:1로 매핑되도록 비정규화. 상태/유형은 String + 앱 상수,
// 금액·수량은 Int, 배열은 String[](Postgres), 좌석 슬롯은 Json.
// 날짜류는 앱이 문자열(YYYY-MM-DD / ISO)로 다루므로 String 으로 저장해 변환 오류를 없앤다.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 풀링(pgbouncer) — 런타임 쿼리
  directUrl = env("DIRECT_URL") // 직접 연결 — 마이그레이션/db push
  // 앱 테이블을 전용 스키마(sadan)로 격리 → 기존 public/auth 테이블과 충돌 없음
  schemas   = ["sadan"]
}

// ─── 계정 / 권한 ───
model Account {
  id          String   @id
  name        String
  email       String   @unique
  password    String
  role        String
  permissions String[] // 접근 가능한 메뉴 키
  active      Boolean  @default(true)
  createdAt   String
  @@schema("sadan")
}

// ─── 기준정보 ───
model MajorCategory {
  id      String           @id
  code    Int
  name    String
  middles MiddleCategory[]
  @@schema("sadan")
}

model MiddleCategory {
  id          String        @id
  code        Int
  name        String
  detailItems String[]      @default([])
  major       MajorCategory @relation(fields: [majorId], references: [id], onDelete: Cascade)
  majorId     String

  @@index([majorId])
  @@schema("sadan")
}

model Building {
  id     String @id
  code   String @unique
  campus String
  name   String
  @@schema("sadan")
}

// ─── 자산 원장 ───
model Asset {
  id                    String  @id
  legacyRowNo           Int?
  expenditureDocument   String?
  managingOrganization  String?
  majorCategory         String
  middleCategory        String
  classificationCode    Int?
  acquiredDate          String?
  itemName              String
  specification         String?
  unitPrice             Int     @default(0)
  sequenceNo            Int?
  place                 String?
  roomName              String?
  buildingCode          String?
  generatedManagementNo String?
  lockedManagementNo    String?
  schoolRfidNo          String?
  usageType             String  @default("미확인")
  currentUserName       String?
  currentLocationNote   String?
  tagStatus             String  @default("미지정")
  assetStatus           String  @default("정상")
  memo                  String?
  createdAt             String
  updatedAt             String
  deletedAt             String?

  @@index([itemName])
  @@index([assetStatus])
  @@index([buildingCode])
  @@index([schoolRfidNo])
  @@schema("sadan")
}

// ─── 대여 (노트북 포함 전체 자산) ───
model LaptopLoan {
  id           String  @id
  assetId      String  @unique
  managementNo String
  itemName     String
  status       String  @default("보관")
  userName     String?
  loanedAt     String?
  dueAt        String?
  returnedAt   String?
  note         String?
  isNotebook   Boolean @default(false)

  @@index([status])
  @@schema("sadan")
}

// ─── 연구재료 / 소모품 ───
model ConsumableItem {
  id                  String  @id
  itemName            String
  specification       String?
  unitPrice           Int     @default(0)
  currentQty          Int     @default(0)
  safetyQty           Int     @default(0)
  unit                String  @default("개")
  location            String?
  roomName            String?
  expenditureDocument String?
  lastInboundAt       String?
  lastOutboundAt      String?
  status              String  @default("정상")
  @@schema("sadan")
}

// ─── 좌석 / 배치 ───
model Seat {
  id           String  @id
  code         String  @unique
  occupantName String?
  assets       Json // SeatAsset[]
  @@schema("sadan")
}
