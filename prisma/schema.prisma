// 사업단 자산관리 플랫폼 — Prisma schema
// 앱 도메인 타입(src/types)과 1:1로 매핑되도록 비정규화. 상태/유형은 String + 앱 상수,
// 금액·수량은 Int, 배열은 String[](Postgres), 좌석 슬롯은 Json.
// 날짜류는 앱이 문자열(YYYY-MM-DD / ISO)로 다루므로 String 으로 저장해 변환 오류를 없앤다.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 풀링(pgbouncer) — 런타임 쿼리
  directUrl = env("DIRECT_URL") // 직접 연결 — 마이그레이션/db push
  // 앱 테이블을 전용 스키마(sadan)로 격리 → 기존 public/auth 테이블과 충돌 없음
  schemas   = ["sadan"]
}

// ─── 계정 / 권한 ───
model Account {
  id          String   @id
  name        String
  email       String   @unique
  password    String
  role        String
  permissions String[] // 접근 가능한 메뉴 키
  active      Boolean  @default(true)
  createdAt   String
  @@schema("sadan")
}

// ─── 기준정보 ───
model MajorCategory {
  id      String           @id
  code    Int
  name    String
  middles MiddleCategory[]
  @@schema("sadan")
}

model MiddleCategory {
  id          String        @id
  code        Int
  name        String
  detailItems String[]      @default([])
  major       MajorCategory @relation(fields: [majorId], references: [id], onDelete: Cascade)
  majorId     String

  @@index([majorId])
  @@schema("sadan")
}

model Building {
  id     String @id
  code   String @unique
  campus String
  name   String
  @@schema("sadan")
}

// ─── 자산 원장 ───
model Asset {
  id                    String  @id
  legacyRowNo           Int?
  expenditureDocument   String?
  managingOrganization  String?
  majorCategory         String
  middleCategory        String
  classificationCode    Int?
  acquiredDate          String?
  itemName              String
  specification         String?
  unitPrice             Int     @default(0)
  sequenceNo            Int?
  place                 String?
  roomName              String?
  buildingCode          String?
  generatedManagementNo String?
  lockedManagementNo    String?
  schoolRfidNo          String?
  usageType             String  @default("미확인")
  currentUserName       String?
  currentLocationNote   String?
  tagStatus             String  @default("미지정")
  assetStatus           String  @default("정상")
  memo                  String?
  createdAt             String
  updatedAt             String
  deletedAt             String?

  @@index([itemName])
  @@index([assetStatus])
  @@index([buildingCode])
  @@index([schoolRfidNo])
  @@schema("sadan")
}

// ─── 대여 (노트북 포함 전체 자산) — 자산 대여 관리 대장 항목 ───
model LaptopLoan {
  id                  String  @id
  assetId             String  @unique
  managementNo        String
  itemName            String
  status              String  @default("보관")
  userName            String? // 대여자
  userAffiliation     String? // 소속
  userIdNo            String? // 사번/학번
  userPhone           String? // 전화번호
  reason              String? // 사유
  loanManager         String? // 대여 관리자
  signature           String? // 대여자 서명 (PNG data URL)
  loanedAt            String? // 대여일자
  dueAt               String? // 반납 예정일
  returnedAt          String? // 반납일자
  returnerName        String? // 반납자
  returnerAffiliation String?
  returnerPhone       String?
  returnManager       String?
  note                String?
  isNotebook          Boolean @default(false)

  @@index([status])
  @@schema("sadan")
}

// ─── 연구재료 / 소모품 ───
model ConsumableItem {
  id                  String  @id
  itemName            String
  specification       String?
  unitPrice           Int     @default(0)
  currentQty          Int     @default(0)
  safetyQty           Int     @default(0)
  unit                String  @default("개")
  location            String?
  roomName            String?
  expenditureDocument String?
  lastInboundAt       String?
  lastOutboundAt      String?
  status              String  @default("정상")
  @@schema("sadan")
}

// ─── 좌석 / 배치 ───
model Seat {
  id           String  @id
  code         String  @unique
  occupantName String?
  assets       Json // SeatAsset[]
  @@schema("sadan")
}

// ─── 시드 메타 (버전드 리시드 제어) ───
model SeedMeta {
  key   String @id
  value String
  @@schema("sadan")
}

// ─── 앱 설정 (구글시트 URL·배포 주소 등 — 하드코딩 대신 DB에서 관리) ───
model AppSetting {
  key   String @id
  value String
  @@schema("sadan")
}

// ─── 홍보물품 기본정보 ───
model PromoItem {
  id          String  @id
  code        String  @unique // 구분코드 (P, Q, R, U …)
  name        String // 물품명
  category    String? // 분류
  spec        String? // 규격/옵션
  unit        String  @default("개")
  location    String? // 보관장소
  manager     String? // 담당자
  vendor      String? // 구매처
  purchasedAt String? // 최초 구입/납품일
  totalAmount Int     @default(0) // 구입금액(합계)
  unitPrice   Int     @default(0)
  safetyQty   Int     @default(0) // 안전재고
  status      String  @default("사용") // 사용 | 사용중지
  docNo       String? // 서류번호
  note        String?
  createdAt   String
  updatedAt   String
  @@schema("sadan")
}

// ─── 홍보물품 수불내역 (모든 재고 변동의 단일 원장 — 재고는 이 합으로 계산) ───
model PromoTxn {
  id           String  @id
  itemId       String
  date         String // 처리일자
  type         String // 최초입고|추가입고|반납|회수|출고|폐기|분실|조정증가|조정감소|출고취소|입고취소
  qty          Int // 항상 양수
  direction    Int // +1 입고성 / -1 출고성
  balanceAfter Int // 변동 후 재고 (기록 시점)
  purpose      String? // 내용/사용 목적
  eventName    String? // 행사명
  takerName    String? // 반출자
  receiverName String? // 수령 대상
  manager      String? // 담당 관리자
  docNo        String? // 서류번호
  unitPrice    Int?
  amount       Int?
  status       String  @default("정상") // 정상 | 취소됨
  cancelOfId   String? // 이 내역이 취소(보정)하는 원본 txn id
  cancelReason String?
  createdBy    String?
  createdAt    String

  @@index([itemId, date])
  @@index([status])
  @@schema("sadan")
}

// ─── 홍보물품 출고 신청 (승인 흐름) ───
model PromoRequest {
  id                   String  @id
  itemId               String
  qty                  Int
  outType              String  @default("행사 배부") // 출고 유형
  purpose              String
  eventName            String?
  eventDate            String?
  requesterName        String
  requesterAffiliation String?
  requesterPhone       String?
  status               String  @default("신청") // 신청|승인|반려|출고완료|취소
  managerName          String? // 처리 관리자
  rejectReason         String?
  txnId                String? // 출고완료 시 연결된 수불내역
  createdAt            String
  updatedAt            String

  @@index([status])
  @@index([itemId])
  @@schema("sadan")
}
